# Security headers for all statically-served pages/assets.
# Cloudflare's asset handler applies this file (Vite copies public/_headers -> dist/_headers).
# NOTE: these headers cover static asset responses; the Worker sets its own headers on /api/*.
#
# CSP note: script-src and style-src keep 'unsafe-inline' because the app relies on inline
# onclick handlers and inline style="" attributes throughout its generated markup. That means
# CSP is NOT the primary defense against injected inline handlers (output-escaping is) — its
# value here is blocking external/object/base/frame vectors and third-party script loads.
# A stronger CSP (dropping 'unsafe-inline' via nonces) requires first removing inline handlers.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.tile.openstreetmap.org; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; child-src 'self' blob:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
